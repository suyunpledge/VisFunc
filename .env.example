# SVSG 服务配置模板 —— 复制为 .env 后按需修改

# ---- 服务监听 ----
SVSG_HOST=127.0.0.1
SVSG_PORT=3002

# ---- L3 主控（使用真实后端时改为 openai 并配置下方三项）----
SVSG_LLM_PROVIDER=stub
# SVSG_LLM_BASE_URL=https://api.openai.com/v1
# SVSG_LLM_API_KEY=
# SVSG_LLM_MODEL=
SVSG_LLM_TIMEOUT_S=3.0

# ---- L1.5 视觉验证（必须严格小于 LLM_TIMEOUT_S 的 1/3）----
SVSG_L15_PROVIDER=disabled
SVSG_L15_TIMEOUT_S=0.9
# SVSG_L15_BASE_URL=
# SVSG_L15_API_KEY=
# SVSG_L15_MODEL=
# SVSG_L15_MAX_REGIONS=8

# ---- L1 图片编译：disabled | functions（像素函数）| demo | yolo（需 .[ml]） ----
SVSG_DETECTOR=disabled
SVSG_YOLO_WEIGHTS=yolov8n.pt

# ---- 多模态识别 /v1/recognize-image（独立于 L3，由下方调用预算控制）----
SVSG_VISION_PROVIDER=disabled
# SVSG_VISION_BASE_URL=
# SVSG_VISION_API_KEY=
# SVSG_VISION_MODEL=
# 可选：同一 API 提供商下的独立复核模型，例如 mimo-v2.6-pro
# SVSG_VISION_REVIEW_MODEL=
SVSG_VISION_TIMEOUT_S=90
SVSG_VISION_MAX_OBJECTS=12
SVSG_VISION_STRATEGY=multiview
SVSG_VISION_MAX_CALLS=5
SVSG_VISION_DISCOVERY_VIEWS=2
SVSG_VISION_JSON_MODE=true
# 仅在后端支持 thinking.type=disabled 时启用，例如当前 MiMo 配置
SVSG_VISION_THINKING_DISABLED=false

# ---- 可观测性 ----
SVSG_SAMPLE_MODE=steady
SVSG_TRACE_FILE=traces.jsonl
SVSG_LOG_LEVEL=INFO

# ---- 安全 / 网关入口（设置后所有 /v1/* 需携带 X-API-Key 头）----
SVSG_API_KEY=
SVSG_CORS_ORIGINS=[]
# SVSG_CORS_ORIGINS 逗号分隔时可用 JSON 数组：SVSG_CORS_ORIGINS=["https://a.com","https://b.com"]
# -- 登录机制 v0（可选）--
# SVSG_AUTH_ENABLED=1            # 启用后 /v1/* 需要 Bearer 令牌（/auth/* 提供注册/登录）
# SVSG_AUTH_DB=svsg_auth.db      # 用户/令牌库路径（建议启用时写绝对路径）
# SVSG_AUTH_TOKEN_TTL_S=604800   # 令牌有效期，默认 7 天
# SVSG_AUTH_PBKDF2_ITERS=200000  # 口令 PBKDF2 迭代次数
